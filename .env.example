# FastAPI Order Service URL (default local instance)
ORDER_API_URL=http://127.0.0.1:8000

# Google Gemini API Configuration (Recommended)
# Get a free API key at: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.5-flash

# Optional Alternative: OpenAI or compatible endpoint (Groq, Ollama, etc.)
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o-mini
OPENAI_BASE_URL=

